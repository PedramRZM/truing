{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "src/vendor/**",
    "test/fixtures/**",
    "refs/**",
    ".agents/skills/**",
    ".claude/skills/**"
  ]
}
