{
  "name": "truing",
  "version": "0.1.0",
  "description": "Refine your real app visually. Zero config: Claude reads your project, and every change lands in your source as a reviewable edit.",
  "keywords": [
    "design",
    "visual-editing",
    "claude",
    "claude-code",
    "next.js",
    "react",
    "tailwindcss",
    "design-tokens",
    "devtools"
  ],
  "homepage": "https://github.com/PedramRZM/truing#readme",
  "bugs": {
    "url": "https://github.com/PedramRZM/truing/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedramRZM/truing.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "truing": "bin/truing.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs/modules.md",
    "examples",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-build": "node scripts/check-build.mjs",
    "perf": "tsx scripts/perf.ts",
    "check-claude": "tsx scripts/check-claude-session.ts",
    "check-first-run": "tsx scripts/check-first-run.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/node": "4.3.3",
    "bippy": "0.7.3",
    "colorjs.io": "0.5.2",
    "esbuild": "0.25.12",
    "jiti": "2.7.0",
    "lucide-react": "1.11.0",
    "magic-string": "0.30.21",
    "playwright": "1.59.1",
    "postcss": "8.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.8.3",
    "ws": "8.18.0",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/node": "20.14.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "class-variance-authority": "^0.7.1",
    "next": "16.2.9",
    "oxlint": "1.90.0",
    "prettier": "^3.6.2",
    "radix-ui": "^1.6.7",
    "tw-animate-css": "^1.4.0",
    "vitest": "4.0.16"
  }
}
