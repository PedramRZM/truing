{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/agent/check *)",
      "Bash(scripts/agent/next-task *)",
      "Bash(scripts/agent/ratchet *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh release *)",
      "Bash(pnpm publish *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(*.pem)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(./secrets/**)",
      "Edit(./refs/**)",
      "Write(./refs/**)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "mcp__claude_ai_Claude_Docs"
    ]
  },
  "sandbox": {
    "credentials": {
      "envVars": [
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_AUTH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ZAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "DEEPSEEK_API_KEY",
          "mode": "deny"
        },
        {
          "name": "MOONSHOT_API_KEY",
          "mode": "deny"
        },
        {
          "name": "KIMI_API_KEY",
          "mode": "deny"
        }
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-check.py"],
            "timeout": 300,
            "statusMessage": "Running quick checks"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
