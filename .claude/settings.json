{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check *)",
      "Bash(make sync *)",
      "Bash(make help *)",
      "Bash(make test *)",
      "Bash(make e2e *)",
      "Bash(make board *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm format *)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(backlog *)",
      "Bash(npx -y backlog.md@1.53.0 *)",
      "Bash(python3 tools/*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(pnpm publish *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "mcp__claude_ai_Claude_Docs",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git commit --no-verify *)"
    ]
  },
  "enabledMcpjsonServers": ["deepwiki", "context7"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/agent-hooks/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Artifact.*|mcp__claude_ai_Claude_Docs__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Claude artifacts and Claude Docs are off in this repo (AGENTS.md golden rule 12): write the output as a file in the repo instead.' >&2; exit 2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/agent-hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/tools/agent-hooks/stop_check.py\"",
            "timeout": 120,
            "statusMessage": "Running make check…"
          }
        ]
      }
    ]
  }
}
