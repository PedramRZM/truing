#!/usr/bin/env node
// Stands in for the `claude` binary in the setup tests, so they spend nothing,
// open no browser, and can reach states a real login can't (signed out, expired).
// FAKE_CLAUDE picks the scenario: ok (default), signed-out, sign-in-works,
// sign-in-fails, expired, questions, monorepo, no-port, bad-values, read-error,
// bad-shape.
const args = process.argv.slice(2);
const scenario = process.env.FAKE_CLAUDE ?? 'ok';
const root = process.cwd();

const reading = {
  name: 'fake-shop',
  summary: 'A small shop front built with Next.js.',
  framework: { name: 'Next.js', version: '16.2.9' },
  frameworkEvidence: 'package.json depends on next.',
  appDir: null,
  appDirEvidence: 'next.config.ts sits at the root.',
  devCommand: process.env.FAKE_DEV_COMMAND ?? 'node server.mjs',
  devCommandEvidence: 'package.json, the dev script.',
  port: Number(process.env.FAKE_PORT ?? 3199),
  portEvidence: 'server.mjs listens on it.',
  startRoute: '/',
  startRouteEvidence: 'There is an app/page.tsx.',
  source: 'src',
  sourceEvidence: 'The code lives in src.',
  primitives: 'src/ui',
  primitivesEvidence: 'components.json names it.',
  tokens: null,
  tokensEvidence: 'No Tailwind v4 stylesheet in this project.',
  tailwindMerge: null,
  writableInclude: ['src/**/*.tsx'],
  writableExclude: ['src/server/**'],
  writableEvidence: 'Server code lives in src/server.',
  checks: ['pnpm typecheck'],
  checksEvidence: 'package.json, the typecheck script.',
  dropEnv: [],
  dropEnvEvidence: 'No hooks test a variable.',
  questions: [],
};

function print(value) {
  process.stdout.write(`${JSON.stringify(value)}\n`);
}

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

async function read() {
  const step = (name, input) =>
    print({
      type: 'assistant',
      message: { content: [{ type: 'tool_use', name, input }] },
    });
  step('Glob', { pattern: '*' });
  await sleep(150);
  step('Read', { file_path: `${root}/package.json` });
  await sleep(150);
  step('Grep', { pattern: 'listen' });
  await sleep(150);

  if (scenario === 'read-error') {
    print({ type: 'result', is_error: true, result: 'Claude hit a limit.' });
    return;
  }
  if (scenario === 'questions') {
    print({
      type: 'result',
      structured_output: {
        ...reading,
        devCommand: null,
        port: null,
        questions: [
          {
            field: 'devCommand',
            question: 'Two scripts could start this. Which one do you use?',
            options: ['node server.mjs', 'node other.mjs'],
          },
        ],
      },
    });
    return;
  }
  if (scenario === 'no-port') {
    print({
      type: 'result',
      structured_output: {
        ...reading,
        port: null,
        portEvidence: 'Nothing in the project names one.',
      },
    });
    return;
  }
  if (scenario === 'with-tokens') {
    print({
      type: 'result',
      structured_output: { ...reading, tokens: 'tokens.css' },
    });
    return;
  }
  if (scenario === 'bad-shape') {
    print({ type: 'result', structured_output: { name: 1 } });
    return;
  }
  if (scenario === 'monorepo') {
    const prompt = args.at(-1) ?? '';
    print({
      type: 'result',
      structured_output: prompt.includes('apps/web')
        ? { ...reading, name: 'web', appDir: null }
        : {
            ...reading,
            questions: [
              {
                field: 'project',
                question: 'Which app do you mean?',
                options: ['apps/web', 'apps/admin'],
              },
            ],
          },
    });
    return;
  }
  if (scenario === 'bad-values') {
    print({
      type: 'result',
      structured_output: {
        ...reading,
        primitives: 'src/not-here',
        tokens: '../../outside.css',
        port: 99999,
      },
    });
    return;
  }
  print({ type: 'result', structured_output: reading });
}

async function main() {
  if (args[0] === '--version') {
    console.log('9.9.9 (Claude Code)');
    return;
  }
  if (args[0] === 'auth' && args[1] === 'status') {
    const signedIn =
      !['signed-out', 'sign-in-works', 'sign-in-fails'].includes(scenario) ||
      (scenario === 'sign-in-works' &&
        (await import('node:fs')).existsSync(process.env.FAKE_LOGIN_MARK ?? ''));
    console.log(
      JSON.stringify({
        loggedIn: signedIn,
        authMethod: signedIn ? 'claude.ai' : 'none',
        email: 'never-shown@example.com',
        ...(signedIn ? { subscriptionType: 'pro' } : {}),
      }),
    );
    process.exit(signedIn ? 0 : 1);
  }
  if (args[0] === 'auth' && args[1] === 'login') {
    if (scenario === 'sign-in-fails') process.exit(1);
    if (process.env.FAKE_LOGIN_MARK) {
      (await import('node:fs')).writeFileSync(process.env.FAKE_LOGIN_MARK, '');
    }
    return;
  }
  if (args.includes('--json-schema')) {
    // As the real one does.
    const schema = JSON.parse(args[args.indexOf('--json-schema') + 1]);
    if (schema.$schema) {
      console.error('Error: --json-schema is not a valid JSON Schema');
      process.exit(1);
    }
    await read();
    return;
  }
  if (scenario === 'expired') {
    print({ is_error: true, result: 'Login expired. Please run /login' });
    process.exit(1);
  }
  print({ is_error: false, result: 'ready' });
}

void main();
